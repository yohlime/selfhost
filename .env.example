# Root Compose environment
# Copy this file to .env and replace the placeholders.
# This file should contain only values used for Compose interpolation or
# genuinely shared across services. Service secrets belong in <service>/.env.

# Compose-wide
DOMAIN=home.example.com
ZONE_NAME=example.com
TZ=Asia/Manila
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
REDIS_IMAGE=redis:8-alpine

# Immich
IMMICH_UPLOAD_LOCATION=/path/to/immich/upload
IMMICH_DB_DATA_LOCATION=/path/to/immich/db
IMMICH_DB_NAME=immich

# OpenClaw
OPENCLAW_IMAGE=openclaw:local
OPENCLAW_CONFIG_DIR=/path/to/openclaw/config
OPENCLAW_WORKSPACE_DIR=/path/to/openclaw/workspace
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan

# Networking and ingress
SFTPGO_SFTP_BIND_IP=100.64.0.1
VW_DOMAIN=vw.home.example.com
CLOUDFLARE_TUNNEL_TOKEN=change-me

# DNS script only (scripts/update_cf_record.sh)
CF_API_TOKEN=change-me
ZONE_ID=change-me

# Service-specific secrets live in <service>/.env, for example:
#   dawarich/.env       OIDC_*, GEOAPIFY_API_KEY
#   garmin/.env         GARMIN_MCP_HTTP_TOKEN, optional GARMIN_EMAIL/PASSWORD
#   meilisearch/.env    MEILI_MASTER_KEY
#   yamtrack/.env       SECRET
#   openclaw/.env       provider tokens and integrations
#   traefik/.env        CF_API_EMAIL, CF_DNS_API_TOKEN
